p3c.txt
p3final.txt
/p3*.txt

# Playwright MCP 测试产物（截图/快照/日志）
.playwright-mcp/

# 防止 Playwright 快照误写入根目录
/login*.yml
/after-login*.yml
/dashboard*.yml

# 根目录一次性 API/数据输出
/response.body
/response.txt
/estimate*.json
/users.json
/devices.json
/*.session.txt

# 不允许 npm 在 pnpm workspace 根目录创建第二套锁文件
/package-lock.json

# 本地一次性帮助脚本；正式工具必须进入 scripts/
/__*.js
/__*.py

# 本地一次性调试产物
dashboard-final.png
response.txt
*.session.txt

# TALOS Runtime Supervisor（日志、诊断包、Node report、可选原生 dump）
.talos-runtime/

# OS
.DS_Store
Thumbs.db

# Local Git worktrees
.worktrees/

# 临时文件 / 转移快照（不得提交）
